# Cloudinary Media Storage (Unsigned frontend uploads)
# Configured in Cloudinary Settings > Upload > Upload presets (Signing mode: Unsigned).
VITE_CLOUDINARY_CLOUD_NAME="dwo7oemds"
VITE_CLOUDINARY_UPLOAD_PRESET="VDVC_PORTFOLIO"

# Firebase web config (public identifiers, not secrets). Set these in Vercel > Project > Settings >
# Environment Variables (and in a local .env.local) to point the site at your own Firebase project.
# If VITE_FIREBASE_PROJECT_ID is not set, the bundled firebase-applet-config.json is used.
# Find the values in Firebase console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Leave as (default) unless you created a named Firestore database.
VITE_FIREBASE_DATABASE_ID="(default)"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
