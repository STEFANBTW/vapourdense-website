{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Portfolio case study project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string", "enum": ["Graphic Design", "Web Design"] },
        "client": { "type": "string" },
        "threeWordDesc": { "type": "string" },
        "descriptors": { "type": "string" },
        "websiteUrl": { "type": "string" },
        "isRealLife": { "type": "boolean" },
        "price": { "type": "string" },
        "currency": { "type": "string" },
        "duration": { "type": "string" },
        "year": { "type": "string" },
        "featured": { "type": "boolean" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "videos": { "type": "array", "items": { "type": "string" } },
        "deliverables": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "category", "client", "description", "images"]
    },
    "About": {
      "title": "About Data",
      "description": "Studio about section configuration",
      "type": "object",
      "properties": {
        "studioName": { "type": "string" },
        "founderName": { "type": "string" },
        "bio": { "type": "string" },
        "badge": { "type": "string" },
        "founderImage": { "type": "string" },
        "disciplines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "num": { "type": "string" },
              "title": { "type": "string" },
              "description": { "type": "string" }
            },
            "required": ["id", "num", "title", "description"]
          }
        },
        "phone": { "type": "string" },
        "phones": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "string" },
        "emails": { "type": "array", "items": { "type": "string" } },
        "socials": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "twitter": { "type": "string" },
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "dribbble": { "type": "string" }
          }
        },
        "updatedAt": { "type": "number" }
      },
      "required": ["studioName", "founderName", "bio", "phone", "email"]
    },
    "Brief": {
      "title": "Client Brief",
      "description": "Client intake project brief submitted via booking flow",
      "type": "object",
      "properties": {
        "referenceId": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "preferredContact": { "type": "string" },
        "businessName": { "type": "string" },
        "industry": { "type": "string" },
        "service": { "type": "string" },
        "profileType": { "type": "string" },
        "projectType": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "customGoal": { "type": "string" },
        "feelMood": { "type": "string" },
        "feelDescription": { "type": "string" },
        "referenceWebsiteLink": { "type": "string" },
        "scopePages": { "type": "string" },
        "graphicQuantity": { "type": "string" },
        "brandAssets": { "type": "string" },
        "existingAssets": { "type": "string" },
        "techStackPreference": { "type": "string" },
        "systemCurrentState": { "type": "string" },
        "timelineType": { "type": "string" },
        "timelineWeeks": { "type": "number" },
        "budgetType": { "type": "string" },
        "exactBudgetAmount": { "type": "number" },
        "budgetBand": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "unread", "read"] },
        "submittedAt": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["referenceId", "fullName", "email", "service", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "entity": "Project",
      "description": "Collection of portfolio case studies"
    },
    "/settings/about": {
      "entity": "About",
      "description": "Studio about information"
    },
    "/briefs/{briefId}": {
      "entity": "Brief",
      "description": "Collection of client intake project briefs"
    }
  }
}
