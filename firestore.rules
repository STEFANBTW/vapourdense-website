rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection: readable by everyone, writeable for portfolio updates
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Studio settings & about data: readable by everyone, writeable for updates
    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
